{
  "name": "fieldfind",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "ingest": "python scripts/ingest.py",
    "predev": "node scripts/prepare-pdf-assets.mjs && node --import tsx scripts/prepare-library.ts",
    "prebuild": "node scripts/prepare-pdf-assets.mjs && node --import tsx scripts/prepare-library.ts",
    "prepreview": "node scripts/prepare-pdf-assets.mjs",
    "prepare:library": "node --import tsx scripts/prepare-library.ts",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 4173 --strictPort"
  },
  "dependencies": {
    "dompurify": "^3.4.17",
    "idb": "^8.0.4",
    "minisearch": "^7.2.0",
    "papaparse": "^5.7.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.5",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
